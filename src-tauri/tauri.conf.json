{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vale Studio",
  "version": "0.1.2",
  "identifier": "studio.vale.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vale Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../native/vst3-host/dist/vst3-host.exe": "vst3-host.exe"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
